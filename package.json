{
  "name": "@cobbfan9/asset-studio-web",
  "type": "module",
  "version": "1.0.6",
  "license": "BSD 3-Clause",
  "repository": {
    "type": "git",
    "url": "https://github.com/CobbFan9/asset-studio-web"
  },
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/index.web.d.ts",
        "default": "./dist/index.web.js"
      },
      "node": {
        "types": "./dist/index.node.d.ts",
        "default": "./dist/index.node.js"
      },
      "default": {
        "types": "./dist/index.default.d.ts",
        "default": "./dist/index.default.js"
      }
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "build": "tsup",
    "release": "semantic-release",
    "dev:test-site": "pnpm --filter test-site dev",
    "dev:node-test": "pnpm --filter node-test dev"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.11",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^26.6.6",
    "semantic-release": "^25.0.9",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "pako": "^3.0.3",
    "png-tools": "^1.1.1"
  },
  "allowScripts": {
    "esbuild@0.27.7": true
  },
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": "v26.x"
  }
}