{
  "name": "@cobbfan9/asset-studio-web",
  "type": "module",
  "version": "1.0.6",
  "license": "BSD 3-Clause",
  "repository": {
    "type": "git",
    "url": "https://github.com/CobbFan9/asset-studio-web"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "release": "semantic-release",
    "dev:test-site": "pnpm --filter test-site dev",
    "dev:node-test": "pnpm --filter node-test dev"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.11",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^26.6.6",
    "semantic-release": "^25.0.9",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@lunapaint/png-codec": "^0.2.0"
  },
  "allowScripts": {
    "esbuild@0.27.7": true
  },
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": "v26.x"
  }
}
